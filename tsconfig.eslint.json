{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "allowJs": true,
    "types": ["node"]
  },
  "include": ["*.ts", "*.js", "packages/*/src/**/*.ts"],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
